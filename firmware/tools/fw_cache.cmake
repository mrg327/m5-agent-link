# Keeps a copy of the signed app image where agentlinkd looks for delta-OTA bases (issue ef2c,
# FIRMWARE.md §9): <DIR>/<sha256>.bin, newest 8 kept. Run by the fw_cache build target:
#   cmake -DBIN=<agentlink.bin> -DDIR=<agentlink home>/fw -P fw_cache.cmake
if(NOT EXISTS "${BIN}")
    return()
endif()
file(SHA256 "${BIN}" _sha)
file(MAKE_DIRECTORY "${DIR}")
if(NOT EXISTS "${DIR}/${_sha}.bin")
    file(COPY_FILE "${BIN}" "${DIR}/${_sha}.bin.tmp")
    file(RENAME "${DIR}/${_sha}.bin.tmp" "${DIR}/${_sha}.bin")
    message(STATUS "Delta-OTA base kept: ${DIR}/${_sha}.bin")
else()
    file(TOUCH "${DIR}/${_sha}.bin")
endif()
file(GLOB _bins "${DIR}/*.bin")
set(_stamped)
foreach(_b ${_bins})
    file(TIMESTAMP "${_b}" _t "%Y%m%d%H%M%S" UTC)
    list(APPEND _stamped "${_t}|${_b}")
endforeach()
list(SORT _stamped ORDER DESCENDING)
list(LENGTH _stamped _n)
if(_n GREATER 8)
    list(SUBLIST _stamped 8 -1 _old)
    foreach(_e ${_old})
        string(REGEX REPLACE "^[0-9]+\\|" "" _p "${_e}")
        file(REMOVE "${_p}")
    endforeach()
endif()
