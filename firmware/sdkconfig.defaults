CONFIG_IDF_TARGET="esp32s3"

# Flash / partitions
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_APP_ROLLBACK_ENABLE=y

# 8 MB octal PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# Compiler: -O2 everywhere (19.6 KB smaller and 5.8 KB more DIRAM than -Og; assertions stay on).
# For gdb stepping, switch to CONFIG_COMPILER_OPTIMIZATION_DEBUG: LVGL and M5GFX then still get -O2
# from boards/stopwatch/CMakeLists.txt.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# CPU / RTOS
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Console on the built-in USB Serial/JTAG (debug lines are "#"-prefixed JSON)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# LVGL 9.5
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_DEF_REFR_PERIOD=33
# Circle-edge cache, flushed every frame: one ring frame uses 9 radii (see simulator/lv_conf.h)
CONFIG_LV_DRAW_SW_CIRCLE_CACHE_SIZE=12
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_FONT_MONTSERRAT_28=y

# BLE: NimBLE peripheral (+ central API for MTU exchange), one connection, host memory in PSRAM
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# Central role is needed by link_ble.cpp (ble_gattc_exchange_mtu)
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_LL_CFG_FEAT_LE_2M_PHY=y
CONFIG_BT_NIMBLE_PINNED_TO_CORE_0=y
CONFIG_BT_CTRL_BLE_MAX_ACT=3
