diff --git a/drivers/bluetooth/hci_bcm.c b/drivers/bluetooth/hci_bcm.c
--- a/drivers/bluetooth/hci_bcm.c
+++ b/drivers/bluetooth/hci_bcm.c
@@ -679,10 +679,36 @@ static int bcm_setup(struct hci_uart *hu)
 	.lsize = 0, \
 	.maxlen = BCM_TYPE52_SIZE
 
+/* BCM4350C0 (MacBookPro14,1) ROM firmware sets reserved upper bits in the event type of LE
+ * Advertising Reports (0x20 for ADV_IND, 0x23 for ADV_NONCONN_IND, 0x24 for SCAN_RSP), so the core
+ * drops every report ("unknown advertising packet type") and LE connections never start. Keep the
+ * defined bits of a type that is out of range; a valid type (0..4) is never touched. */
+static int bcm_recv_event(struct hci_dev *hdev, struct sk_buff *skb)
+{
+	if (skb->len >= 4 && skb->data[0] == HCI_EV_LE_META &&
+	    skb->data[2] == HCI_EV_LE_ADVERTISING_REPORT) {
+		u8 num = skb->data[3];
+		u8 *p = skb->data + 4;
+		u8 *end = skb->data + skb->len;
+
+		/* report: evt_type, bdaddr_type, bdaddr[6], length, data[length], rssi */
+		while (num-- && p + 10 <= end) {
+			u8 len = p[8];
+
+			if (p + 10 + len > end)
+				break;
+			if (p[0] > 0x04)
+				p[0] &= 0x07;
+			p += 10 + len;
+		}
+	}
+	return hci_recv_frame(hdev, skb);
+}
+
 static const struct h4_recv_pkt bcm_recv_pkts[] = {
 	{ H4_RECV_ACL,      .recv = hci_recv_frame },
 	{ H4_RECV_SCO,      .recv = hci_recv_frame },
-	{ H4_RECV_EVENT,    .recv = hci_recv_frame },
+	{ H4_RECV_EVENT,    .recv = bcm_recv_event },
 	{ H4_RECV_ISO,      .recv = hci_recv_frame },
 	{ BCM_RECV_LM_DIAG, .recv = hci_recv_diag  },
 	{ BCM_RECV_NULL,    .recv = hci_recv_diag  },
