; agentlink protocol v0.1 — single source of truth.
; See docs/design/PROTOCOL.md for semantics. Integer keys; symbolic names in comments.
; Rule: decoders MUST ignore unknown map keys and unknown message types.
; Keys are scoped per map (key 0 in `session` is unrelated to key 0 in `hello`).

; ───────────────────────── envelope ─────────────────────────
; Every message is a CBOR map. Key 0 (t) is the message type and determines the body
; schema, which makes the envelope a discriminated union.
;   { 0: t, 1: id, ?2: re, 3: body }
;   id = sender's monotonic per-link message counter; re = id this message replies to.
envelope = msg_hello / msg_welcome / msg_snapshot / msg_session_upd / msg_gone
         / msg_attention / msg_clear / msg_cmd / msg_result / msg_detail
         / msg_cfg / msg_batt / msg_ping / msg_pong / msg_log
         / msg_audio_start / msg_audio / msg_audio_end / msg_transcript
         / msg_kb_start / msg_kb_stroke / msg_kb_cands / msg_usage
         / msg_fw_begin / msg_fw_chunk / msg_fw_ack / msg_power
         / msg_dbg_ui_state_req / msg_dbg_ui_state / msg_dbg_screenshot_req
         / msg_dbg_screenshot_chunk / msg_dbg_inject_input / msg_dbg_set_log_level

hdr = (1 => uint, ? 2 => uint)

msg_hello                = { 0 => mt_hello, hdr, 3 => hello }
msg_welcome              = { 0 => mt_welcome, hdr, 3 => welcome }
msg_snapshot             = { 0 => mt_snapshot, hdr, 3 => snapshot }
msg_session_upd          = { 0 => mt_session_upd, hdr, 3 => session }
msg_gone                 = { 0 => mt_gone, hdr, 3 => gone }
msg_attention            = { 0 => mt_attention, hdr, 3 => attention }
msg_clear                = { 0 => mt_clear, hdr, 3 => clear }
msg_cmd                  = { 0 => mt_cmd, hdr, 3 => cmd }
msg_result               = { 0 => mt_result, hdr, 3 => result }
msg_detail               = { 0 => mt_detail, hdr, 3 => detail }
msg_cfg                  = { 0 => mt_cfg, hdr, 3 => device_cfg }
msg_batt                 = { 0 => mt_batt, hdr, 3 => batt }
msg_ping                 = { 0 => mt_ping, hdr, 3 => empty }
msg_pong                 = { 0 => mt_pong, hdr, 3 => empty }
msg_log                  = { 0 => mt_log, hdr, 3 => log }
msg_audio_start          = { 0 => mt_audio_start, hdr, 3 => audio_start }
msg_audio                = { 0 => mt_audio, hdr, 3 => audio }
msg_audio_end            = { 0 => mt_audio_end, hdr, 3 => audio_end }
msg_transcript           = { 0 => mt_transcript, hdr, 3 => transcript }
msg_kb_start             = { 0 => mt_kb_start, hdr, 3 => kb_start }
msg_kb_stroke            = { 0 => mt_kb_stroke, hdr, 3 => kb_stroke }
msg_kb_cands             = { 0 => mt_kb_cands, hdr, 3 => kb_cands }
msg_usage                = { 0 => mt_usage, hdr, 3 => usage }
msg_fw_begin             = { 0 => mt_fw_begin, hdr, 3 => fw_begin }
msg_fw_chunk             = { 0 => mt_fw_chunk, hdr, 3 => fw_chunk }
msg_fw_ack               = { 0 => mt_fw_ack, hdr, 3 => fw_ack }
msg_power                = { 0 => mt_power, hdr, 3 => power }
msg_dbg_ui_state_req     = { 0 => mt_dbg_ui_state_req, hdr, 3 => empty }
msg_dbg_ui_state         = { 0 => mt_dbg_ui_state, hdr, 3 => dbg_ui_state }
msg_dbg_screenshot_req   = { 0 => mt_dbg_screenshot_req, hdr, 3 => empty }
msg_dbg_screenshot_chunk = { 0 => mt_dbg_screenshot_chunk, hdr, 3 => dbg_screenshot_chunk }
msg_dbg_inject_input     = { 0 => mt_dbg_inject_input, hdr, 3 => dbg_inject_input }
msg_dbg_set_log_level    = { 0 => mt_dbg_set_log_level, hdr, 3 => dbg_set_log_level }

; types 64+ are debug / observability (DESIGN §0)
mt_hello = 1
mt_welcome = 2
mt_snapshot = 3
mt_session_upd = 4
mt_gone = 5
mt_attention = 6
mt_clear = 7
mt_cmd = 8
mt_result = 9
mt_detail = 10
mt_cfg = 11
mt_batt = 12
mt_ping = 13
mt_pong = 14
mt_log = 15
mt_audio_start = 16
mt_audio = 17
mt_audio_end = 18
mt_transcript = 19
mt_kb_start = 20
mt_kb_stroke = 21
mt_kb_cands = 22
mt_usage = 23
mt_fw_begin = 24
mt_fw_chunk = 25
mt_fw_ack = 26
mt_power = 27
mt_dbg_ui_state_req = 64
mt_dbg_ui_state = 65
mt_dbg_screenshot_req = 66
mt_dbg_screenshot_chunk = 67
mt_dbg_inject_input = 68
mt_dbg_set_log_level = 69

empty = {}

; ───────────────────────── handshake ─────────────────────────
hello = {
  0 => [major: uint, minor: uint],   ; proto  (currently [0, 1])
  1 => device_info,                  ; dev
  2 => caps,                         ; caps
  ? 3 => uint                       ; batt_pct
}

device_info = {
  0 => device_class,   ; class
  1 => tstr,           ; board   e.g. "m5stopwatch", "sim"
  2 => tstr,           ; fw      semver
  3 => bstr .size 8   ; uid     stable device id
}
device_class = device_class_watch / device_class_desk / device_class_pad /
  device_class_sim / device_class_other
device_class_watch = 0
device_class_desk = 1
device_class_pad = 2
device_class_sim = 3
device_class_other = 15

caps = {
  ? 0 => display_caps,   ; disp
  1 => [0*4 input_kind],   ; input
  ? 2 => uint,           ; nbtn
  3 => bool,             ; haptic
  4 => bool,             ; spk
  5 => bool,             ; mic
  6 => bool,             ; batt
  7 => uint,             ; max_msg (bytes)
  8 => [0*12 feature]     ; feats
}
display_caps = {
  0 => disp_shape,   ; shape
  1 => uint,                   ; w
  2 => uint,                   ; h
  3 => bool                   ; color
}
input_kind = input_kind_touch / input_kind_btn / input_kind_rotary / input_kind_imu
input_kind_touch = 0
input_kind_btn = 1
input_kind_rotary = 2
input_kind_imu = 3

feature = feature_focus / feature_ack / feature_approve / feature_reply /
  feature_voice / feature_badge / feature_debug / feature_scroll / feature_keys
feature_focus = 0
feature_ack = 1
feature_approve = 2
feature_reply = 3
feature_voice = 4
feature_badge = 5
feature_debug = 6
feature_scroll = 7   ; the device drives the terminal's scrollback (cmd_op_scroll, UI-V2 §6)
feature_keys = 8     ; the device has the KEYS swipe keyboard (kb_*, proto 0.7)

welcome = {
  0 => [major: uint, minor: uint],   ; proto
  1 => host_info,                    ; host
  2 => time_sync,                    ; time
  3 => device_cfg,                   ; cfg
  ? 4 => [0*6 tstr],                 ; replies  quick replies, each <= 24 chars (proto 0.4); present = the
                                     ;          daemon types into terminals (cmd_op_type, cmd_op_cancel)
  ? 5 => bool,                       ; voice    the daemon transcribes audio_* and answers with transcript
                                     ;          (proto 0.6); cmd_op_dictate then types it
  ? 6 => bool,                       ; keys     the daemon decodes kb_stroke into kb_cands and types them
                                     ;          (proto 0.7, cmd_op_kb_*)
  ? 7 => bool                        ; pointer  the daemon moves its own machine's pointer for cmd_op_pointer
                                     ;          (proto 0.20, EXPERIMENTS.md); absent or false = it cannot
}
host_info = {
  0 => bstr .size 8,                  ; id
  1 => tstr,                          ; name
  2 => host_os      ; os
}
time_sync = {
  0 => uint,   ; unix (seconds)
  1 => int    ; tz_off (minutes)
}
device_cfg = {
  ? 0 => privacy,      ; privacy
  ? 1 => alert_mode,   ; alert
  ? 2 => uint,         ; quiet_until (unix, 0 = none)
  ? 3 => uint,         ; brightness 0..255
  ? 4 => tstr         ; badge_handle
}
privacy = privacy_meta / privacy_preview / privacy_full
privacy_meta = 0
privacy_preview = 1
privacy_full = 2

alert_mode = alert_mode_full / alert_mode_quiet / alert_mode_silent
alert_mode_full = 0
alert_mode_quiet = 1
alert_mode_silent = 2

; ───────────────────────── state ─────────────────────────
snapshot = {
  0 => [0*32 session],        ; sessions
  ? 1 => [0*16 away_event]   ; away   events missed while disconnected
}
away_event = {
  0 => uint,        ; sid
  1 => att_kind,    ; kind
  2 => uint        ; ts (unix)
}

; `session` is used both as a full object (in snapshot) and as a delta
; (session_upd): in a delta only `sid` is required; absent keys = unchanged.
session = {
  0 => uint,                 ; sid   daemon-assigned, stable for session lifetime
  ? 1 => agent,              ; ag
  ? 2 => sess_state,         ; st
  ? 3 => input_sub,          ; sub   when st = input
  ? 4 => tstr,               ; repo  ≤ 32 chars
  ? 5 => tstr,               ; br    ≤ 32 chars
  ? 6 => tstr,               ; tool  current tool
  ? 7 => uint,               ; t0    start (unix)
  ? 8 => uint,               ; tst   last state change (unix)
  ? 9 => tstr,               ; sum   preview ≤ 80 chars (privacy-dependent)
  ? 10 => bool,              ; seen
  ? 11 => uint,              ; host  host index: 0 = the daemon's own PC, 1.. = remote hosts (REMOTE.md)
  ? 12 => tstr,             ; hn    remote host name ≤ 16 chars; only with host != 0, only to devices with proto ≥ 0.2
  ? 13 => uint,             ; snz   snoozed until (unix); 0 = not snoozed. Keys 13-16 only to devices with proto ≥ 0.3
  ? 14 => bool,             ; ntf   "notify when done" armed; the daemon clears it in the delta that enters done/error
  ? 15 => uint,             ; n     tool steps in the current turn (resets on a new prompt)
  ? 16 => bool,             ; ok    result of step n; absent while it runs
  ? 17 => tstr,             ; q     the agent's closing question when its turn ended, <= 120 chars; "" = none (proto 0.5)
  ? 18 => [0*3 tstr],       ; rp    answers to q for the Reply list, <= 24 chars each; [] = none (proto 0.5)
  ? 19 => uint,             ; eta   a job's expected total run time in seconds (median of its earlier runs);
                            ;       0 = unknown. Keys 19-20 and agent_shell only to devices with proto ≥ 0.9
  ? 20 => uint,             ; exit  a job's exit status (0-255), sent with the delta that enters done / error
  ? 21 => uint,             ; ctx   context window used, percent 0-100; 255 = unknown (GAUGES.md). Keys 21-25
                            ;       only to devices with proto ≥ 0.10
  ? 22 => tstr,             ; mdl   the model's short name, <= 16 chars ("Opus 4.7"); "" = unknown
  ? 23 => perm_mode,        ; pm    the agent's permission mode
  ? 24 => uint,             ; pr    the open pull request of the session's branch; 0 = none (withheld under privacy meta)
  ? 25 => pr_state,         ; prs   its review state; sent with pr
  ? 26 => bool,             ; hush  only in the delta that enters done / error, only to devices with proto >= 0.12
                            ;       (PRESENCE.md): the user is looking at that session's terminal, do not buzz for
                            ;       it. Never stored by the device; absent = buzz as its own rules say
  ? 30 => uint,             ; fc    files the turn changed (>= 1; absent = not known / none seen). Keys 30-34 only to
                            ;       devices with proto >= 0.14 (DONE-SUMMARY.md); a delta carrying any of them
                            ;       replaces the whole summary, a delta that changes `st` clears it
  ? 31 => uint,             ; la    lines added in the turn, sent with lr; absent = not known
  ? 32 => uint,             ; lr    lines removed
  ? 33 => bool,             ; tp    the turn's last recognised test run: true passed, false failed; absent = unknown
  ? 34 => uint,             ; dur   the turn's length in seconds, prompt to stop
  ? 35 => tstr,            ; qd    the message queued for this session (proto 0.17, PROTOCOL.md §4b): the
                            ;       start of its text, <= 48 chars, cut with "…"; "" = none. Only to devices with
                            ;       proto >= 0.17. The daemon types the message the next time the session can take
                            ;       input and then sends qd: "". The user's own words: the trace shows <private>
  ? 36 => uint,             ; lm    the agent's last message (proto 0.18, LAST-MESSAGE.md): its id, new for each
                            ;       message (never reused in a daemon run); 0 = none. Keys 36-38 only to devices with
                            ;       proto >= 0.18. The whole text: cmd_op_detail {sid, arg: off} with no rid
  ? 37 => uint,             ; ll    its length in bytes as the reader shows it (markdown cleaned, <= 4096)
  ? 38 => tstr              ; lp    its start, one paragraph, <= 160 bytes; "" under privacy meta (agent content:
                            ;       the trace shows <private>)
}
perm_mode = perm_mode_default / perm_mode_plan / perm_mode_accept_edits / perm_mode_auto /
  perm_mode_dont_ask / perm_mode_bypass
perm_mode_default = 0       ; Claude Code "default" (shown as Manual): asks before edits and commands
perm_mode_plan = 1
perm_mode_accept_edits = 2
perm_mode_auto = 3
perm_mode_dont_ask = 4
perm_mode_bypass = 5        ; bypassPermissions

pr_state = pr_state_none / pr_state_pending / pr_state_approved / pr_state_changes / pr_state_draft
pr_state_none = 0           ; no review state reported
pr_state_pending = 1
pr_state_approved = 2
pr_state_changes = 3        ; changes requested
pr_state_draft = 4
agent = agent_copilot / agent_claude / agent_cloud / agent_shell / agent_other
agent_copilot = 0
agent_claude = 1
agent_cloud = 2
agent_shell = 3      ; a job: a command the user started in a terminal (proto 0.9, JOBS.md)
agent_other = 15

sess_state = sess_state_start / sess_state_work / sess_state_input / sess_state_error /
  sess_state_done / sess_state_idle / sess_state_ended
sess_state_start = 0
sess_state_work = 1
sess_state_input = 2
sess_state_error = 3
sess_state_done = 4
sess_state_idle = 5
sess_state_ended = 6

input_sub = input_sub_approval / input_sub_question
input_sub_approval = 0
input_sub_question = 1

gone = { 0 => uint }   ; sid

attention = {
  0 => uint,              ; rid   request id (required for approve/deny/reply)
  1 => uint,              ; sid
  2 => att_kind,          ; kind
  ? 3 => tstr,            ; title  e.g. "Run shell command"
  ? 4 => tstr,            ; text   preview ≤ 160 chars
  ? 5 => [0*4 tstr],        ; opts   ≤ 4 choices, each ≤ 24 chars
  6 => [0*6 action],        ; acts   actions the device may offer
  ? 7 => uint,            ; exp    unix time after which to drop
  ? 8 => uint,           ; grant_mask  bit i set = opts[i] grants permission (approve-class: hold to commit)
  ? 9 => uint,           ; left   ms left in the answer window when this message was sent (ANSWER-WINDOW.md);
                         ;        the device counts down from its own clock on arrival. Keys 9-11 only to
                         ;        devices with proto >= 0.11
  ? 10 => uint,          ; win    the whole answer window in ms (left / win = the part still to run)
  ? 11 => uint,          ; len    the full text's length in bytes, sent when `text` is a cut preview: the
                         ;        device may fetch it with cmd_op_detail (detail chunks) when len <= 4096
  ? 12 => bool,          ; hush   no buzz, glow or reminders for this request: the user is looking at its terminal
                         ;        (PRESENCE.md). The card is shown and answered as ever. Only to devices with
                         ;        proto >= 0.12
  ? 13 => tstr,          ; rule   the standing rule the device may grant with this request, exactly as Claude Code
                         ;        saves it ("Bash(npm test:*)"; several one per line), <= 160 bytes of printable
                         ;        ASCII and line breaks (STANDING-RULES.md). Keys 13-15 always together, only to
                         ;        devices with proto >= 0.13; granted by cmd_op_approve with `rh`
  ? 14 => uint,          ; scope  where it is saved, a rule_scope value. A uint, not the enum, so that a value a
                         ;        device does not know drops the rule, not the whole request
  ? 15 => bool,          ; wide   the rule ends in a wildcard: it matches more than this exact request
  ? 16 => [1*4 ask_q]    ; qs     an agent's multiple-choice questions (Claude Code AskUserQuestion; proto 0.18,
                         ;        LAST-MESSAGE.md): the device answers them all at once with cmd_op_answer. Only
                         ;        to devices with proto >= 0.18; an older device gets title / text / opts as before
}
; One question of `qs`: header (<= 16 bytes), the question (<= 160 bytes), its options, and whether several
; may be picked. The device may also offer a free answer ("Other") by dictation.
ask_q = {
  0 => tstr,             ; h     header, e.g. "Framework"
  1 => tstr,             ; q     the question
  2 => [1*4 ask_opt],    ; o     options in the agent's order
  ? 3 => bool            ; m     multi-select: any number of options (at least one)
}
ask_opt = {
  0 => tstr,             ; l     label (<= 48 bytes), what the agent receives
  ? 1 => tstr            ; d     description (<= 120 bytes), readable on the device
}
rule_scope = rule_scope_session / rule_scope_project
rule_scope_session = 0   ; this session only (Claude Code destination "session")
rule_scope_project = 1   ; this project, the user's own .claude/settings.local.json ("localSettings")
att_kind = att_kind_approval / att_kind_question / att_kind_error / att_kind_done
att_kind_approval = 0
att_kind_question = 1
att_kind_error = 2
att_kind_done = 3

action = action_approve / action_deny / action_focus / action_reply / action_ack / action_dictate
action_approve = 0
action_deny = 1
action_focus = 2
action_reply = 3
action_ack = 4
action_dictate = 5   ; the card takes a dictated answer: cmd_op_dictate with its rid (proto 0.8)

clear = {
  0 => uint,   ; rid
  1 => clear_why   ; why
}

; ───────────────────────── commands ─────────────────────────
cmd = {
  0 => cmd_op,     ; op
  ? 1 => uint,     ; sid
  ? 2 => uint,     ; rid   (dictate: the card the transcript answers, proto 0.8)
  ? 3 => cmd_arg,  ; arg   snooze minutes, reply option index, quiet secs
  ? 4 => uint,    ; hold_ms  measured hold-to-confirm (approve)
  ? 5 => uint,    ; rh  with cmd_op_approve (proto 0.13): also save the request's standing rule. FNV-1a 32 of
                  ;     the rule's bytes, 0x00, the scope's value and the wide flag (0/1), as the device showed
                  ;     them; hold_ms >= 1500 (STANDING-RULES.md)
  ? 6 => bool,    ; q   with cmd_op_type / cmd_op_dictate (proto 0.17): queue the message if the session cannot
                  ;     take input now; the daemon types it the next time it can. One per session: a new one
                  ;     replaces the old. Not with a `rid`
  ? 7 => answer_picks, ; picks  with cmd_op_answer (proto 0.18): per question of the request's `qs`, in order, the
                  ;     options picked as a bit mask (bit i = option i); 0 when that question has a dictated answer
  ? 8 => answer_aids, ; aids   with cmd_op_answer: per question, the recording (aid) whose transcript is the free
                  ;     answer ("Other"); 0 = none
  ? 9 => pointer_arg  ; ptr  with cmd_op_pointer (proto 0.20)
}
answer_picks = [1*4 picks: uint]
answer_aids = [1*4 aids: uint]
; Scalars for snooze / reply / quiet; a map for scroll. Further structured arguments ({aid}) join this union when they land.
cmd_arg = uint / tstr / scroll_arg
cmd_op = cmd_op_focus / cmd_op_ack / cmd_op_snooze / cmd_op_approve / cmd_op_deny /
  cmd_op_reply / cmd_op_cancel / cmd_op_detail / cmd_op_notify_done / cmd_op_quiet / cmd_op_scroll /
  cmd_op_type / cmd_op_dictate / cmd_op_kb_pick / cmd_op_kb_del / cmd_op_kb_send / cmd_op_kb_end /
  cmd_op_rerun / cmd_op_unqueue / cmd_op_answer / cmd_op_pointer
cmd_op_focus = 0    ; with a `rid` (proto 0.11): also hand that request back to the terminal at once
cmd_op_ack = 1
cmd_op_snooze = 2
cmd_op_approve = 3
cmd_op_deny = 4
cmd_op_reply = 5
cmd_op_cancel = 6   ; interrupt the session's running turn (the daemon sends Esc to its terminal)
cmd_op_detail = 7   ; send request `rid`'s full text from byte `arg` (0 = from the start) as detail chunks (proto 0.11);
                    ; with no rid (proto 0.18): session `sid`'s last message, its chunks carry `lm`
cmd_op_notify_done = 8
cmd_op_quiet = 9
cmd_op_scroll = 10
cmd_op_type = 11    ; type quick reply `arg` (an index into welcome.replies) + Enter into the session's terminal
cmd_op_dictate = 12 ; type the transcript of recording `arg` (an aid) + Enter into the session's terminal
cmd_op_kb_pick = 13 ; KEYS: replace the last typed word with candidate `arg` of the latest kb_cands
cmd_op_kb_del = 14  ; KEYS: erase the last word typed from the watch
cmd_op_kb_send = 15 ; KEYS: press Enter (hold_ms >= 1000); the composition is sent to the agent
cmd_op_kb_end = 16  ; KEYS: the keyboard closed; `arg` 1 erases what it typed and was not sent, 0 keeps it
cmd_op_rerun = 17   ; JOBS: run a finished job's command again in its own terminal (hold_ms >= 1000; proto 0.9)
cmd_op_unqueue = 18 ; drop session `sid`'s queued message (proto 0.17); stale when there is none
cmd_op_answer = 19  ; answer request `rid`'s questions (`qs`) at once with `picks` / `aids`, after a hold (hold_ms
                    ; >= 1000; proto 0.18)
cmd_op_pointer = 20 ; Trackpad (proto 0.20, EXPERIMENTS.md): move / click / scroll the pointer of the daemon's own
                    ; machine with `ptr`. No `result` unless it fails (at most one per second): `unsupported` (no
                    ; pointer backend) or `denied` (the OS refused, e.g. macOS Accessibility not granted)

; cmd_op_pointer argument. Fields apply in order: move by (dx, dy), then click, then scroll. Absent = 0.
pointer_arg = {
  ? 0 => int,          ; dx      pointer pixels, positive = right
  ? 1 => int,          ; dy      pointer pixels, positive = down
  ? 2 => pointer_btn,  ; btn     press and release this button once at the pointer
  ? 3 => uint,         ; n       its click count: 1 = a click, 2 = the second click of a double click; default 1
  ? 4 => int          ; wheel   scroll notches, positive = down (towards newer content)
}
pointer_btn = pointer_left / pointer_right
pointer_left = 0
pointer_right = 1

; cmd_op_scroll argument (UI-V2 §6.1): move the session's terminal scrollback.
scroll_arg = {
  0 => scroll_unit,   ; unit
  1 => int,           ; delta   negative = up (older), positive = down (newer); for scroll_to_end < 0 = top, > 0 = bottom (live)
  ? 2 => uint        ; seq     device-side counter, so the daemon can drop stale bursts
}
scroll_unit = scroll_lines / scroll_pages / scroll_to_end
scroll_lines = 0
scroll_pages = 1
scroll_to_end = 2

result = {
  0 => bool,         ; ok
  ? 1 => result_err,   ; err
  ? 2 => tstr,       ; msg
  ? 3 => scroll_pos   ; pos   only in answers to cmd_op_scroll
}
; Where the terminal's view is after a scroll (UI-V2 §6.1). `preview` is terminal content: sent only when
; the device's privacy is preview or full, cut at 48 chars, never logged.
scroll_pos = {
  0 => uint,     ; lines_above   lines between the view and the live bottom; 0 = live
  1 => bool,     ; at_bottom
  ? 2 => uint,   ; total         scrollback size when known (for the position track)
  ? 3 => tstr   ; preview       top visible line, ≤ 48 chars
}

; The full text of request `rid` (proto 0.11, ANSWER-WINDOW.md), the answer to cmd_op_detail {rid, arg: off}.
; Sent as chunks of <= 1024 bytes, cut on UTF-8 boundaries, in order from `off`; a `result` follows the last.
detail = {
  ? 0 => uint,   ; rid
  ? 1 => uint,   ; sid
  2 => tstr,     ; text   this chunk
  ? 3 => uint,   ; off    byte offset of this chunk in the full text
  ? 4 => uint,   ; total  the full text's length in bytes (<= 4096)
  ? 5 => uint    ; lm     with no rid (proto 0.18): the id of the session's last message this chunk is from
}


batt = {
  0 => uint,   ; pct
  1 => bool   ; chg
}

log = {
  0 => log_level,   ; lvl
  1 => tstr                                   ; msg
}

; ───────────────────────── audio (v3) ─────────────────────────
audio_start = {
  0 => uint,                              ; aid
  1 => audio_codec,   ; codec
  ? 2 => uint                            ; sid
}
audio = {
  0 => uint,               ; aid
  1 => uint,               ; seq
  2 => bstr .size (0..240) ; data
}
audio_end = { 0 => uint }  ; aid
transcript = {
  0 => uint,   ; aid
  1 => tstr,   ; text      "" when nothing was heard (or the recording failed); <= 2047 bytes (proto >= 0.16), else <= 255
  2 => uint   ; autosend_ms  0: never; the device sends only on the user's hold (cmd_op_dictate)
}

; ───────────────────────── keyboard (proto 0.7) ─────────────────────────
; KEYS (PROTOCOL.md §7): the watch sends key geometry and finger paths, never text; the daemon decodes
; them and types into the session's terminal.
kb_start = {
  0 => uint,                    ; kid    one per opening of the keyboard; a repeat with the same kid swaps the layer
  1 => uint,                    ; sid
  2 => bstr .size (0..640)      ; keys   per key 10 B LE: u16 cp, i16 x, i16 y, u16 w, u16 h (top-left, px)
}
kb_stroke = {
  0 => uint,                    ; kid
  1 => uint,                    ; seq    stroke number within kid, from 1
  2 => bstr .size (0..1200)     ; pts    per point 6 B LE: i16 x, i16 y, u16 t_ms since touch-down
}
kb_cands = {
  0 => uint,                    ; kid
  1 => uint,                    ; seq    the stroke these answer
  2 => [0*4 tstr],              ; cands  best first, each <= 24 chars
  ? 3 => uint,                  ; typed  index of the candidate now in the terminal (absent: none typed)
  ? 4 => result_err             ; err    why nothing was typed
}

; ───────────────────────── usage (proto 0.10, GAUGES.md) ─────────────────────────
; The plan's rate-limit windows, from Claude Code's status line. A full replacement: a window that is
; absent is unknown (no subscription, no reading yet, or it has reset), never zero. Sent only to devices
; with proto ≥ 0.10.
usage = {
  0 => uint,      ; at    when the daemon last read these figures (unix); the device ages them from here
  ? 1 => uint,    ; h5    5-hour window used, percent 0-100 (rounded down)
  ? 2 => uint,    ; h5r   5-hour window resets at (unix)
  ? 3 => uint,    ; h5o   at the current pace the 5-hour window runs out at (unix); absent = not before it resets
  ? 4 => uint,    ; wk    weekly window used, percent 0-100
  ? 5 => uint,    ; wkr   weekly window resets at (unix)
  ? 6 => uint     ; wko   at the current pace the weekly window runs out at (unix)
}

; ───────────────────────── firmware update (proto 0.15, FIRMWARE.md §9) ─────────────────────────
; The daemon pushes a signed app image into the device's spare app slot; only to devices with proto >= 0.15.
; The device answers every fw_begin and fw_chunk with fw_ack; `next` is the offset it wants next, so a lost
; or out-of-order chunk is simply sent again from there. The daemon keeps at most 4 chunks unanswered.
fw_begin = {
  0 => uint,               ; size   the image's length in bytes; 0 = stop the transfer in progress
  1 => bstr .size 32,      ; sha    SHA-256 of the whole image: a begin naming the image already in progress
                           ;        (same sha and size) resumes it at the device's `next`
  ? 2 => tstr,             ; ver    the image's version (its app description), <= 32 chars, for the screen
  ? 3 => fw_patch          ; patch  (proto 0.21) the chunks carry a patch against the running image, not
                           ;        the image itself; `size` and `sha` still describe the rebuilt image
}
; A detools sequential patch (bsdiff, heatshrink window 11 lookahead 10). The device rebuilds the image from the
; first `bsize` bytes of its running app slot; if their SHA-256 is not `base` it acks bad "Base mismatch".
fw_patch = {
  0 => uint,               ; psize  the patch's length in bytes
  1 => bstr .size 32,      ; base   SHA-256 of the base image (the first bsize bytes of the running slot)
  2 => uint                ; bsize  the base image's length in bytes
}
fw_chunk = {
  0 => uint,                 ; off    byte offset of this chunk in the image (in the patch, with fw_begin.patch)
  1 => bstr .size (0..2048)  ; data
}
fw_ack = {
  0 => fw_status,   ; st
  1 => uint,        ; next   bytes received and written so far: the offset the device wants next (a patch
                    ;        offset, with fw_begin.patch)
  ? 2 => tstr       ; msg    why, for busy / bad / fail / stopped, <= 48 chars
}
fw_status = fw_status_go / fw_status_done / fw_status_busy / fw_status_bad / fw_status_fail /
  fw_status_stopped
fw_status_go = 0        ; send from `next`
fw_status_done = 1      ; the whole image arrived and was verified (hash, signature); it boots next and the
                        ; device restarts about a second after this ack
fw_status_busy = 2      ; not now (recording, low battery, cannot update itself): nothing was written
fw_status_bad = 3       ; the image was refused (size, not an app image, signature); the transfer is over
fw_status_fail = 4      ; writing the flash failed; the transfer is over
fw_status_stopped = 5   ; the transfer ended without an image: a begin with size 0, the user cancelled on the
                        ; device, or no chunk came for 30 s. May be sent unasked

; ───────────────────────── power report (proto 0.19, POWER.md) ─────────────────────────
; Device → daemon, only to a daemon whose welcome says proto >= 0.19: right after the welcome, then every
; 5 minutes while welcomed. The times cover everything since the previous report that went out: they add up
; while no daemon listens, and across a deep sleep (RTC memory). on + dim + off + deep is the time covered.
power = {
  0 => uint,     ; mv     battery voltage, the last raw reading (mV); 0 = no reading
  1 => uint,     ; mvf    battery voltage as filtered for the device's own percent (mV)
  2 => uint,     ; vin    input (USB / charger) voltage (mV)
  3 => bool,     ; chg    charging
  4 => bool,     ; usb    external power present
  5 => uint,     ; pct    battery percent as the device shows it (linear 3.3-4.2 V)
  6 => uint,     ; on     ms with the display on at full look
  7 => uint,     ; dim    ms with the display on and dimmed to the ambient face
  8 => uint,     ; off    ms with the display off (standby)
  9 => uint,     ; deep   ms in deep sleep, measured across the wake reboot
  10 => uint,    ; lk     ms welcomed by a daemon, on any transport
  11 => uint,    ; ble    ms with a BLE central connected
  12 => uint,    ; itvl   BLE connection interval in force now (us); 0 = no BLE connection
  13 => uint,    ; seq    report number since power-on (kept across deep sleep); 0 = the first
  14 => uint     ; nd     deep sleeps that ended within these times
}

; ───────────────────────── debug / observability ─────────────────────────
dbg_ui_state = {
  0 => tstr,          ; screen   "glance" | "list" | "detail" | "attention" | "badge" | "settings" | "pairing" | "off"
  ? 1 => uint,        ; sel_sid
  ? 2 => uint,        ; rid      attention card shown
  3 => [0*8 tstr],      ; visible  short labels of visible elements, top→bottom
  4 => tstr,          ; power    "active" | "standby" | "badge" | "deep" | "docked"
  ? 5 => uint        ; fps
}
dbg_screenshot_chunk = {
  0 => uint,      ; w
  1 => uint,      ; h
  2 => uint,      ; offset (bytes into RGB565 little-endian buffer)
  3 => bstr,      ; data
  4 => bool      ; last
}
dbg_inject_input = {
  0 => input_event,   ; kind
  ? 1 => int,   ; x
  ? 2 => int   ; y
}
dbg_set_log_level = {
  0 => log_level
}

; ───────────────────────── named enums ─────────────────────────
disp_shape = disp_shape_round / disp_shape_rect
disp_shape_round = 0
disp_shape_rect = 1

host_os = host_os_mac / host_os_win / host_os_linux
host_os_mac = 0
host_os_win = 1
host_os_linux = 2

clear_why = clear_why_answered_pc / clear_why_answered_dev / clear_why_expired /
  clear_why_cancelled / clear_why_handed_back
clear_why_answered_pc = 0
clear_why_answered_dev = 1
clear_why_expired = 2        ; the answer window ran out: the terminal asks now (the hook gave no decision)
clear_why_cancelled = 3
clear_why_handed_back = 4    ; the device's own Open on PC (cmd_op_focus with the rid) released the hook at
                             ; once; only to devices with proto >= 0.11 (older ones get cancelled)

result_err = result_err_stale / result_err_denied / result_err_unsupported /
  result_err_no_window / result_err_timeout / result_err_internal
result_err_stale = 0
result_err_denied = 1
result_err_unsupported = 2
result_err_no_window = 3
result_err_timeout = 4
result_err_internal = 5

log_level = log_level_err / log_level_warn / log_level_info / log_level_debug
log_level_err = 0
log_level_warn = 1
log_level_info = 2
log_level_debug = 3

audio_codec = audio_codec_adpcm16k / audio_codec_opus16k
audio_codec_adpcm16k = 0
audio_codec_opus16k = 1

input_event = input_event_tap / input_event_double_tap / input_event_long_press /
  input_event_swipe_up / input_event_swipe_down / input_event_swipe_left /
  input_event_swipe_right / input_event_btn_a / input_event_btn_b /
  input_event_btn_a_long / input_event_btn_b_long / input_event_lift / input_event_shake
input_event_tap = 0
input_event_double_tap = 1
input_event_long_press = 2
input_event_swipe_up = 3
input_event_swipe_down = 4
input_event_swipe_left = 5
input_event_swipe_right = 6
input_event_btn_a = 7
input_event_btn_b = 8
input_event_btn_a_long = 9
input_event_btn_b_long = 10
input_event_lift = 11
input_event_shake = 12
