  "haptic_meaning": {
    "detent": "A click each time the rim scrub crosses into another segment",
    "hold_ramp": "Pulses grow longer and the gaps shorter while the approve hold fills",
    "tick": "A light acknowledgement of a button selection",
    "approved": "Approve was sent: one long pulse",
    "denied": "Deny was sent: two medium pulses",
    "reject": "A command could not be sent: three short pulses",
    "hello": "Link up: proves the motor path, even in silent mode",
    "done": "An agent finished",
    "error": "An agent hit an error",
    "question": "An agent is asking a question",
    "permission": "An agent needs approval"
  },
