# Line endings: every text file is stored and checked out with LF (all tracked files already are);
# git's content detection decides what is text.
* text=auto eol=lf

# Binary fixtures and build outputs: never diffed or converted.
*.bin binary
*.wasm binary
*.wav binary
*.png binary
*.pdf binary
protocol/fixtures/ota/*.patch binary

# Generated files (docs/conventions/structure.md S-GEN-01, S-GEN-02): edit the generator or its input,
# rerun it, commit both. GitHub collapses their diffs. Checked by scripts/check.d/structure.py.
firmware/components/agentlink_proto/src/agentlink_codec_*.c linguist-generated=true
firmware/components/agentlink_proto/include/agentlink_codec_*.h linguist-generated=true
protocol/vectors/*.json linguist-generated=true
protocol/fixtures/ota/base.bin linguist-generated=true
protocol/fixtures/ota/new.bin linguist-generated=true
protocol/fixtures/ota/*.patch linguist-generated=true
atlas/data/facts.json linguist-generated=true
atlas/css/tokens.generated.css linguist-generated=true
atlas/css/mote.generated.css linguist-generated=true
atlas/img/mote.svg linguist-generated=true
atlas/img/favicon-*.svg linguist-generated=true
atlas/img/favicon-*.png linguist-generated=true
firmware/components/core/src/mote_look.h linguist-generated=true
daemon/crates/agentlink/src/mote.rs linguist-generated=true
atlas/vendor/watch.* linguist-generated=true
firmware/components/core/src/fonts/font_*.c linguist-generated=true
daemon/crates/agentlink-keys/data/english.txt linguist-generated=true
daemon/Cargo.lock linguist-generated=true
firmware/tools/fonts/package-lock.json linguist-generated=true

